##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores

# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/
*.tsbuildinfo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Built kanata binaries (generated by build:kanata script)
src-tauri/binaries/

# Environment
.env
.env.local
